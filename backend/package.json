{
  "name": "@profly/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit",
    "test:unit": "node --import tsx --test test/unit.test.ts test/mail.test.ts test/scheduling.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration.test.ts test/privacy.test.ts test/documents.test.ts test/pagination.test.ts test/maintenance.test.ts test/preview-history.test.ts test/rooms.test.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "create-admin": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "fastify": "^5.0.0",
    "mongodb": "^7.0.0",
    "nodemailer": "^10.2.1",
    "pdf-lib": "1.17.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "mongodb-memory-server": "^10.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
