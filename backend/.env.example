NODE_ENV=development
HOST=127.0.0.1
PORT=3333
# Copiar para .env local. Nunca usar um banco de producao nos testes.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=profly_development
ALLOWED_ORIGINS=http://localhost:5173
SESSION_HOURS=8
UPLOAD_MAX_BYTES=5242880
UPLOAD_DIRECTORY=.data/certificates
# Bootstrap manual, somente para criar o primeiro administrador:
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
