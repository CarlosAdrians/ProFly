NODE_ENV=development
HOST=127.0.0.1
PORT=3333
# Copiar para .env local. Nunca usar um banco de producao nos testes.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=profly_development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5174
SESSION_HOURS=8
# Ativar em HTTPS local; em producao Secure e obrigatorio.
# COOKIE_SECURE=true
UPLOAD_MAX_BYTES=5242880
UPLOAD_DIRECTORY=.data/certificates
# Padrao sem envio. Para captura Mailpit local, troque somente EMAIL_TRANSPORT para smtp.
EMAIL_TRANSPORT=disabled
PUBLIC_APP_URL=http://127.0.0.1:5174
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=plain
SMTP_FROM=profly@profly.test
# Gmail/institucional: usar TLS (implicit/465 ou starttls/587), remetente autorizado
# e credenciais somente no .env local; nunca usar SMTP_SECURITY=plain fora do Mailpit.
# SMTP_USER=
# SMTP_PASSWORD=
# Bootstrap manual, somente para criar o primeiro administrador:
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# LGPD: pendente ate definicao institucional. Nao inventar controlador/base/prazos.
PRIVACY_APPROVED=false
PRIVACY_HEALTH_UPLOADS_ENABLED=false
# Obrigatorios em producao ou quando PRIVACY_APPROVED=true:
# PRIVACY_CONTROLLER=Razao social do controlador definido pela instituicao
# PRIVACY_CONTACT_EMAIL=canal-real-definido-pela-instituicao
# PRIVACY_PROCESSING_BASIS=Fundamentacao revisada por finalidade
# PRIVACY_RETENTION_NOTICE=Prazos e criterios por categoria aprovados
# Para liberar novos atestados fora dos testes, tambem e obrigatorio:
# PRIVACY_HEALTH_BASIS=Fundamentacao especifica para dados de saude aprovada
