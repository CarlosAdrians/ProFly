# Frontend conectado por padrão. Nunca coloque URI MongoDB ou credenciais aqui.
VITE_DEMO_MODE=false
# Opcional: destino do proxy Vite, apenas no processo de desenvolvimento.
PROFLY_API_TARGET=http://127.0.0.1:3333

# HTTPS local opcional: use um .env.https.local privado; veja docs/HTTPS_LOCAL.md.
# Variáveis apenas do processo Node/Vite, sem prefixo VITE_:
# PROFLY_TLS_PFX=C:/certificados-privados/profly-local.pfx
# PROFLY_TLS_PFX_PASSWORD=definida-localmente-sem-commitar
